# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # secreta: NUNCA en el frontend
# Project Settings → API → JWT Settings → JWT Secret (déjalo vacío si tu proyecto usa JWT Signing Keys nuevas)
SUPABASE_JWT_SECRET=

STORAGE_BUCKET=leaf-images
MODEL_DIR=model_files
MODEL_FILE=leaf_model.keras        # el viejo binario: plant_model_best.keras
CORS_ORIGINS=http://localhost:5173

MAX_UPLOAD_MB=8
MAX_IMAGE_SIDE=1280
MAX_QUEUE=8
RATE_LIMIT_PER_MIN=30
TF_THREADS=2
